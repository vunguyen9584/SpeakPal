// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Level {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

enum League {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum Voice {
  VOICE_1
  VOICE_2
  VOICE_3
}

enum Personality {
  CHEERFUL
  STRICT
  SARCASTIC
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  PREMIUM_PLUS
}

enum ConversationMode {
  INSTRUCTOR
  FREETALK
  ROLEPLAY
}

enum Speaker {
  USER
  AI
}

enum CorrectionType {
  GRAMMAR
  VOCABULARY
  PRONUNCIATION
  NATURALNESS
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum SrsLevel {
  NEW
  LEARNING
  YOUNG
  MATURE
  MASTERED
}

enum ScenarioCategory {
  DAILY
  BUSINESS
  TRAVEL
  ACADEMIC
  TEST_PREP
}

enum ScenarioDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ChallengeType {
  CONVERSATION
  VOCABULARY
  PRONUNCIATION
  STREAK
  TIME
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

// ============================================================================
// USER & AUTH MODELS
// ============================================================================

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  username         String?
  passwordHash     String?   @map("password_hash")
  level            Level     @default(BEGINNER)
  totalXp          Int       @default(0) @map("total_xp")
  currentLevelXp   Int       @default(0) @map("current_level_xp")
  league           League    @default(BRONZE)
  aiSpeed          Float     @default(1.0) @map("ai_speed")
  confirmationMode Boolean   @default(true) @map("confirmation_mode")
  isVerified       Boolean   @default(false) @map("is_verified")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  personas       Persona[]
  subscription   Subscription?
  conversations  Conversation[]
  vocabularies   Vocabulary[]
  userChallenges UserChallenge[]
  // Note: Other relations (streak, etc.) will be added in subsequent tasks

  @@index([email])
  @@index([league])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model Persona {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  name        String
  voice       Voice
  personality Personality
  targetLevel Level       @map("target_level")
  isDefault   Boolean     @default(false) @map("is_default")
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, isDefault])
  @@map("personas")
}

model Subscription {
  id              String           @id @default(uuid())
  userId          String           @unique @map("user_id")
  plan            SubscriptionPlan @default(FREE)
  dailyUsageCount Int              @default(0) @map("daily_usage_count")
  dailyUsageLimit Int              @default(3) @map("daily_usage_limit")
  lastResetDate   DateTime         @default(now()) @map("last_reset_date") @db.Date
  expiresAt       DateTime?        @map("expires_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([expiresAt])
  @@map("subscriptions")
}

// ============================================================================
// CONVERSATION MODELS
// ============================================================================

model Conversation {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  personaId          String?          @map("persona_id")
  scenarioId         String?          @map("scenario_id")
  mode               ConversationMode
  topic              String?
  durationSeconds    Int?             @map("duration_seconds")
  pronunciationScore Int?             @map("pronunciation_score")
  xpEarned           Int              @default(0) @map("xp_earned")
  summary            String?          @db.Text
  startedAt          DateTime         @default(now()) @map("started_at")
  endedAt            DateTime?        @map("ended_at")

  // Relations
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns        ConversationTurn[]
  vocabularies Vocabulary[]
  // Note: persona and scenario relations will be added when those models are created

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, mode])
  @@map("conversations")
}

model ConversationTurn {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  speaker        Speaker
  content        String   @db.Text
  audioUrl       String?  @map("audio_url") @db.Text
  sequence       Int
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  corrections  Correction[]

  @@unique([conversationId, sequence])
  @@index([conversationId, sequence])
  @@map("conversation_turns")
}

model Correction {
  id            String         @id @default(uuid())
  turnId        String         @map("turn_id")
  type          CorrectionType
  originalText  String         @map("original_text") @db.VarChar(500)
  correctedText String         @map("corrected_text") @db.VarChar(500)
  explanation   String?        @db.Text
  severity      Severity       @default(MEDIUM)
  createdAt     DateTime       @default(now()) @map("created_at")

  // Relations
  turn ConversationTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId])
  @@index([type])
  @@map("corrections")
}

// ============================================================================
// LEARNING MODELS
// ============================================================================

model Vocabulary {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  conversationId  String?  @map("conversation_id")
  word            String   @db.VarChar(100)
  meaning         String   @db.VarChar(500)
  pronunciation   String?  @db.VarChar(200)
  exampleSentence String?  @map("example_sentence") @db.Text
  srsLevel        SrsLevel @default(NEW) @map("srs_level")
  nextReviewDate  DateTime @default(now()) @map("next_review_date") @db.Date
  reviewCount     Int      @default(0) @map("review_count")
  correctCount    Int      @default(0) @map("correct_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, nextReviewDate])
  @@index([userId, srsLevel])
  @@map("vocabularies")
}

model Scenario {
  id                       String             @id @default(uuid())
  title                    String             @db.VarChar(200)
  titleJa                  String             @map("title_ja") @db.VarChar(200)
  description              String             @db.Text
  category                 ScenarioCategory
  difficulty               ScenarioDifficulty
  initialContext           Json               @map("initial_context")
  objectives               Json               @default("[]")
  keyPhrases               Json               @default("[]") @map("key_phrases")
  estimatedDurationMinutes Int                @default(10) @map("estimated_duration_minutes")
  isActive                 Boolean            @default(true) @map("is_active")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  @@index([category])
  @@index([difficulty])
  @@index([isActive])
  @@map("scenarios")
}

model Challenge {
  id          String        @id @default(uuid())
  type        ChallengeType
  title       String        @db.VarChar(200)
  titleJa     String        @map("title_ja") @db.VarChar(200)
  description String        @db.Text
  condition   Json
  xpReward    Int           @default(50) @map("xp_reward")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")

  // Relations
  userChallenges UserChallenge[]

  @@index([type])
  @@index([isActive])
  @@map("challenges")
}

model UserChallenge {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  challengeId     String          @map("challenge_id")
  assignedDate    DateTime        @default(now()) @map("assigned_date") @db.Date
  currentProgress Int             @default(0) @map("current_progress")
  status          ChallengeStatus @default(ACTIVE)
  completedAt     DateTime?       @map("completed_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId, assignedDate])
  @@index([userId, assignedDate])
  @@index([status])
  @@map("user_challenges")
}

// Models will be added in subsequent tasks
