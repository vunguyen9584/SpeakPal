// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Level {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

enum League {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum Voice {
  VOICE_1
  VOICE_2
  VOICE_3
}

enum Personality {
  CHEERFUL
  STRICT
  SARCASTIC
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  PREMIUM_PLUS
}

enum ConversationMode {
  INSTRUCTOR
  FREETALK
  ROLEPLAY
}

enum Speaker {
  USER
  AI
}

enum CorrectionType {
  GRAMMAR
  VOCABULARY
  PRONUNCIATION
  NATURALNESS
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum SrsLevel {
  NEW
  LEARNING
  YOUNG
  MATURE
  MASTERED
}

enum ScenarioCategory {
  DAILY
  BUSINESS
  TRAVEL
  ACADEMIC
  TEST_PREP
}

enum ScenarioDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ChallengeType {
  CONVERSATION
  VOCABULARY
  PRONUNCIATION
  STREAK
  TIME
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum BadgeCategory {
  STREAK
  LEVEL
  CONVERSATION
  VOCABULARY
  PRONUNCIATION
  SPECIAL
}

enum RankingChange {
  PROMOTED
  DEMOTED
  SAME
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

/// Translation Practice types: Direct, Intent, Word Association, Instant Drill, Shadowing
enum PracticeType {
  DIRECT
  INTENT
  WORD_ASSOCIATION
  INSTANT_DRILL
  SHADOWING
}

/// Shadowing content types
enum ContentType {
  CONVERSATION
  NEWS
  SPEECH
  PODCAST
}

// ============================================================================
// USER & AUTH MODELS
// ============================================================================

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  username         String?
  passwordHash     String?   @map("password_hash")
  level            Level     @default(BEGINNER)
  totalXp          Int       @default(0) @map("total_xp")
  currentLevelXp   Int       @default(0) @map("current_level_xp")
  league           League    @default(BRONZE)
  aiSpeed          Float     @default(1.0) @map("ai_speed")
  confirmationMode Boolean   @default(true) @map("confirmation_mode")
  isVerified       Boolean   @default(false) @map("is_verified")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  personas            Persona[]
  subscription        Subscription?
  conversations       Conversation[]
  vocabularies        Vocabulary[]
  userChallenges      UserChallenge[]
  streak              Streak?
  userBadges          UserBadge[]
  userRankings        UserRanking[]
  sentInvitations     Invitation[]           @relation("SentInvitations")
  usedInvitations     Invitation[]           @relation("UsedInvitations")
  ownedGroups         Group[]                @relation("GroupOwner")
  groupMemberships    GroupMember[]
  translationResults  TranslationResult[]
  quickResponseResults QuickResponseResult[]


  @@index([email])
  @@index([league])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model Persona {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  name        String
  voice       Voice
  personality Personality
  targetLevel Level       @map("target_level")
  isDefault   Boolean     @default(false) @map("is_default")
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, isDefault])
  @@map("personas")
}

model Subscription {
  id              String           @id @default(uuid())
  userId          String           @unique @map("user_id")
  plan            SubscriptionPlan @default(FREE)
  status          String           @default("active") // active, expired, cancelled
  dailyUsageCount Int              @default(0) @map("daily_usage_count")
  dailyUsageLimit Int              @default(3) @map("daily_usage_limit")
  lastResetDate   DateTime         @default(now()) @map("last_reset_date") @db.Date
  expiresAt       DateTime?        @map("expires_at")
  autoRenewing    Boolean          @default(false) @map("auto_renewing")
  orderId         String?          @map("order_id")
  platform        String?          // ios, android
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([expiresAt])
  @@index([status])
  @@map("subscriptions")
}

// ============================================================================
// CONVERSATION MODELS
// ============================================================================

model Conversation {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  personaId          String?          @map("persona_id")
  scenarioId         String?          @map("scenario_id")
  mode               ConversationMode
  topic              String?
  durationSeconds    Int?             @map("duration_seconds")
  pronunciationScore Int?             @map("pronunciation_score")
  xpEarned           Int              @default(0) @map("xp_earned")
  summary            String?          @db.Text
  startedAt          DateTime         @default(now()) @map("started_at")
  endedAt            DateTime?        @map("ended_at")

  // Relations
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns        ConversationTurn[]
  vocabularies Vocabulary[]
  // Note: persona and scenario relations will be added when those models are created

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, mode])
  @@map("conversations")
}

model ConversationTurn {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  speaker        Speaker
  content        String   @db.Text
  audioUrl       String?  @map("audio_url") @db.Text
  sequence       Int
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  corrections  Correction[]

  @@unique([conversationId, sequence])
  @@index([conversationId, sequence])
  @@map("conversation_turns")
}

model Correction {
  id            String         @id @default(uuid())
  turnId        String         @map("turn_id")
  type          CorrectionType
  originalText  String         @map("original_text") @db.VarChar(500)
  correctedText String         @map("corrected_text") @db.VarChar(500)
  explanation   String?        @db.Text
  severity      Severity       @default(MEDIUM)
  createdAt     DateTime       @default(now()) @map("created_at")

  // Relations
  turn ConversationTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId])
  @@index([type])
  @@map("corrections")
}

// ============================================================================
// LEARNING MODELS
// ============================================================================

model Vocabulary {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  conversationId  String?  @map("conversation_id")
  word            String   @db.VarChar(100)
  meaning         String   @db.VarChar(500)
  pronunciation   String?  @db.VarChar(200)
  exampleSentence String?  @map("example_sentence") @db.Text
  srsLevel        SrsLevel @default(NEW) @map("srs_level")
  nextReviewDate  DateTime @default(now()) @map("next_review_date") @db.Date
  reviewCount     Int      @default(0) @map("review_count")
  correctCount    Int      @default(0) @map("correct_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, nextReviewDate])
  @@index([userId, srsLevel])
  @@map("vocabularies")
}

model Scenario {
  id                       String             @id @default(uuid())
  title                    String             @db.VarChar(200)
  titleJa                  String             @map("title_ja") @db.VarChar(200)
  description              String             @db.Text
  category                 ScenarioCategory
  difficulty               ScenarioDifficulty
  initialContext           Json               @map("initial_context")
  objectives               Json               @default("[]")
  keyPhrases               Json               @default("[]") @map("key_phrases")
  estimatedDurationMinutes Int                @default(10) @map("estimated_duration_minutes")
  isActive                 Boolean            @default(true) @map("is_active")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  @@index([category])
  @@index([difficulty])
  @@index([isActive])
  @@map("scenarios")
}

model Challenge {
  id          String        @id @default(uuid())
  type        ChallengeType
  title       String        @db.VarChar(200)
  titleJa     String        @map("title_ja") @db.VarChar(200)
  description String        @db.Text
  condition   Json
  xpReward    Int           @default(50) @map("xp_reward")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")

  // Relations
  userChallenges UserChallenge[]

  @@index([type])
  @@index([isActive])
  @@map("challenges")
}

model UserChallenge {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  challengeId     String          @map("challenge_id")
  assignedDate    DateTime        @default(now()) @map("assigned_date") @db.Date
  currentProgress Int             @default(0) @map("current_progress")
  status          ChallengeStatus @default(ACTIVE)
  completedAt     DateTime?       @map("completed_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId, assignedDate])
  @@index([userId, assignedDate])
  @@index([status])
  @@map("user_challenges")
}

// ============================================================================
// GAMIFICATION MODELS
// ============================================================================

model Streak {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  freezeRemaining  Int       @default(0) @map("freeze_remaining")
  lastActivityDate DateTime? @map("last_activity_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastActivityDate])
  @@map("streaks")
}

model Badge {
  id          String        @id @default(uuid())
  code        String        @unique @db.VarChar(50)
  name        String        @db.VarChar(100)
  nameJa      String        @map("name_ja") @db.VarChar(100)
  description String        @db.Text
  category    BadgeCategory
  iconUrl     String        @map("icon_url") @db.VarChar(255)
  condition   Json
  xpBonus     Int           @default(0) @map("xp_bonus")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")

  // Relations
  userBadges UserBadge[]

  @@index([category])
  @@index([isActive])
  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([earnedAt(sort: Desc)])
  @@map("user_badges")
}

model UserRanking {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  weekNumber Int           @map("week_number")
  year       Int
  league     League
  weeklyXp   Int           @default(0) @map("weekly_xp")
  rank       Int
  change     RankingChange @default(SAME)
  createdAt  DateTime      @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekNumber, year])
  @@index([weekNumber, year, league, weeklyXp(sort: Desc)])
  @@map("user_rankings")
}

// ============================================================================
// SOCIAL MODELS
// ============================================================================

model Invitation {
  id         String           @id @default(uuid())
  senderId   String           @map("sender_id")
  receiverId String?          @map("receiver_id")
  code       String           @unique @db.VarChar(8)
  status     InvitationStatus @default(PENDING)
  bonusXp    Int              @default(50) @map("bonus_xp")
  createdAt  DateTime         @default(now()) @map("created_at")
  expiresAt  DateTime         @map("expires_at")
  usedAt     DateTime?        @map("used_at")

  // Relations
  sender   User  @relation("SentInvitations", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User? @relation("UsedInvitations", fields: [receiverId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([code])
  @@index([status])
  @@map("invitations")
}

model Group {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  name        String   @db.VarChar(100)
  description String?  @db.Text
  maxMembers  Int      @default(10) @map("max_members")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]

  @@index([ownerId])
  @@index([isActive])
  @@map("groups")
}

model GroupMember {
  id       String          @id @default(uuid())
  groupId  String          @map("group_id")
  userId   String          @map("user_id")
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now()) @map("joined_at")

  // Relations
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

// ============================================================================
// SUBSCRIPTION USAGE TRACKING
// ============================================================================

model DailyUsage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  type      String   // conversation, vocabulary
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date, type], name: "userId_date_type")
  @@index([userId, date])
  @@index([date])
  @@map("daily_usage")
}

// ============================================================================
// TRANSLATION PRACTICE MODELS
// ============================================================================

/// Translation questions for direct translation practice (UC-034)
model TranslationQuestion {
  id             String   @id @default(uuid())
  topic          String   @db.VarChar(50) // daily, business, travel, news, entertainment
  level          Level
  sourceLanguage String   @default("ja") @map("source_language") @db.VarChar(5)
  sourceText     String   @map("source_text") @db.Text
  targetText     String   @map("target_text") @db.Text
  altAnswers     Json?    @map("alt_answers") // Alternative correct answers
  difficulty     Int      @default(3) // 1-5
  wordCount      Int      @map("word_count")
  grammarPoints  Json?    @map("grammar_points") // ["present_simple", "articles"]
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  results TranslationResult[]

  @@index([topic, level, isActive])
  @@index([level, difficulty])
  @@map("translation_questions")
}

/// Translation practice results for all practice types
model TranslationResult {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  practiceType    PracticeType @map("practice_type")
  questionId      String?      @map("question_id")
  userAnswer      String       @map("user_answer") @db.Text
  totalScore      Int          @map("total_score") // 0-100
  grammarScore    Int?         @map("grammar_score")
  vocabScore      Int?         @map("vocab_score")
  speedScore      Int?         @map("speed_score")
  intentScore     Int?         @map("intent_score")
  responseTimeSec Float?       @map("response_time_sec")
  feedback        Json?
  xpEarned        Int          @default(0) @map("xp_earned")
  createdAt       DateTime     @default(now()) @map("created_at")

  // Relations
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  question TranslationQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([userId, practiceType, createdAt])
  @@index([userId, createdAt])
  @@map("translation_results")
}

/// Intent-based translation questions (UC-035)
model IntentQuestion {
  id                  String   @id @default(uuid())
  category            String   @db.VarChar(50) // greeting, daily, business, emotion, request
  level               Level
  intentDescription   String   @map("intent_description") @db.Text
  expectedExpressions Json     @map("expected_expressions") // ["Can I...", "Would you..."]
  alternativePhrases  Json     @map("alternative_phrases")
  difficulty          Int      @default(3)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([category, level, isActive])
  @@map("intent_questions")
}

/// Shadowing practice content (UC-038)
model ShadowingContent {
  id           String      @id @default(uuid())
  contentType  ContentType @map("content_type")
  title        String      @db.VarChar(200)
  description  String?     @db.Text
  level        Level
  transcript   String      @db.Text
  audioUrl     String      @map("audio_url") @db.VarChar(500)
  timestamps   Json // [{startTime, endTime, text}]
  durationSec  Int         @map("duration_sec")
  isPremium    Boolean     @default(false) @map("is_premium")
  thumbnailUrl String?     @map("thumbnail_url") @db.VarChar(500)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([contentType, level, isActive])
  @@index([isPremium, isActive])
  @@map("shadowing_contents")
}

/// Quick response practice results (UC-036, UC-037)
model QuickResponseResult {
  id                   String       @id @default(uuid())
  userId               String       @map("user_id")
  practiceType         PracticeType @map("practice_type") // WORD_ASSOCIATION, INSTANT_DRILL, SHADOWING
  sessionId            String?      @map("session_id")
  contentId            String?      @map("content_id")
  totalScore           Int          @map("total_score")
  correctCount         Int?         @map("correct_count")
  maxChain             Int?         @map("max_chain")
  followingScore       Int?         @map("following_score")
  pronunciationScore   Int?         @map("pronunciation_score")
  rhythmScore          Int?         @map("rhythm_score")
  durationSec          Int?         @map("duration_sec")
  details              Json?
  xpEarned             Int          @default(0) @map("xp_earned")
  createdAt            DateTime     @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, practiceType, createdAt])
  @@map("quick_response_results")
}

