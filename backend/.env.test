# Test Environment Configuration
# These are test values - should not be used in production

# Database
DATABASE_URL="postgresql://speakpal_app:dev_password@localhost:5432/speakpal_dev?schema=public"

# JWT
JWT_SECRET="test-jwt-secret-key-for-e2e-testing-only"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="test-refresh-secret-key-for-testing"
JWT_REFRESH_EXPIRES_IN="7d"
WS_JWT_SECRET="test-ws-secret-key-for-testing"

# WebSockets
WEBSOCKET_URL="ws://localhost:3000"

# Firebase - Empty values to skip initialization
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# External APIs - Empty/Test values
OPENAI_API_KEY=""
DEEPGRAM_API_KEY=""
ELEVENLABS_API_KEY=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Server
PORT=3000
NODE_ENV=test
