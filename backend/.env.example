# App Configuration
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://speakpal_app:password@localhost:5432/speakpal_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# AI Services
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_INTERIM_RESULTS=true

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# OpenAI TTS (Text-to-Speech)
# Uses the same API key as OpenAI above
# Get API key from: https://platform.openai.com/api-keys
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_FORMAT=mp3
OPENAI_TTS_SPEED=1

# ElevenLabs TTS (Optional - High quality voices)
# Get API key from: https://elevenlabs.io
# Note: Free tier may have limitations. Consider paid plan for production.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_DEFAULT_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_VOICE_MAP={"sarah":"custom-voice-id"}

# TTSOpenAI (Alternative TTS Service - Recommended)
# Get API key from: https://ttsopenai.com
# More affordable than ElevenLabs, good quality
TTSOPENAI_API_KEY=your-ttsopenai-api-key
TTSOPENAI_BASE_URL=https://api.ttsopenai.com/uapi/v1
TTSOPENAI_MODEL=tts-1
TTSOPENAI_VOICE_ID=OA001
TTSOPENAI_SPEED=1

# Note: Backend will use Mock TTS if no API keys are configured
# Mock TTS is perfect for development and testing

# In-App Purchase (IAP)
# App Store (iOS)
APPSTORE_SHARED_SECRET=your-appstore-shared-secret
APPSTORE_BUNDLE_ID=com.speakpal.app
APPSTORE_USE_SANDBOX=true

# Play Store (Android)
PLAYSTORE_PACKAGE_NAME=com.speakpal.app
PLAYSTORE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
PLAYSTORE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project"}

# AWS S3 Storage
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
